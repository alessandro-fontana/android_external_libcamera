cc_library_headers {
    name: "libcamera_includes",
    vendor_available: true,
    export_include_dirs: [
        "include",
    ],
}

cc_defaults {
    name: "libcamera_default_flags",
    rtti: true,
    cflags: [
        "-g3",
        "-Werror",
        "-Wshadow",
        "-Wno-c99-designator",
    ],
    cpp_std: "c++17",
    cppflags: [
        "-g3",
        "-Werror",
        "-DHAVE_LOCALE_T",
        "-Wshadow",
        "-Wno-c99-designator",
        "-Wextra-semi",
        "-Wno-implicit-fallthrough",
        /* Real path will be set via environment variables at runtime */
        // The IPA modules ship inside the provider APEX, next to the
        // libcamera.so they link against.
        "-DIPA_MODULE_DIR=\"/apex/com.android.hardware.camera.libcamera/lib64/libcamera\"",
        "-DIPA_CONFIG_DIR=\"/vendor/etc/libcamera/ipa/:/vendor/share/libcamera/ipa\"",
        "-DIPA_PROXY_DIR=\"/vendor/bin/libcamera\"",
        "-DLIBCAMERA_SYSCONF_DIR=\"/vendor/etc/libcamera/\"",
        "-DLIBCAMERA_DATA_DIR=\"/data/vendor/hardware/libcamera/\"",
        "-DLIBCAMERA_BASE_PRIVATE",
    ],
}

cc_library_shared {
    name: "libcamera",
    vendor: true,
    defaults: [
        "libcamera_default_flags",
    ],
    srcs: [
        "src/libcamera/*.cpp",
        "src/libcamera/mm/*.cpp",
        "src/libcamera/base/*.cpp",
        "src/libcamera/converter/*.cpp",
        "src/libcamera/sensor/*.cpp",
        "src/libcamera/software_isp/*.cpp",
        "src/libcamera/proxy/*.cpp",
        "src/libcamera/pipeline/simple/*.cpp",
    ],
    exclude_srcs: [
        "src/libcamera/device_enumerator_udev.cpp",
    ],
    header_libs: [
        "libcamera_includes",
    ],
    shared_libs: [
        "libdl",
    ],
    // As in AOSP's external/libcamera: libyaml has no vendor shared variant.
    static_libs: [
        "libyaml",
    ],
}

cc_binary {
    // In the root package: libyaml is visible to //external/libcamera only.
    name: "cam",
    vendor: true,
    cppflags: [
        "-DHAVE_KMS",
    ],
    srcs: [
        "src/apps/cam/camera_session.cpp",
        "src/apps/cam/capture_script.cpp",
        "src/apps/cam/file_sink.cpp",
        "src/apps/cam/frame_sink.cpp",
        "src/apps/cam/main.cpp",
        "src/apps/cam/drm.cpp",
        "src/apps/cam/kms_sink.cpp",
        "src/apps/common/image.cpp",
        "src/apps/common/options.cpp",
        "src/apps/common/stream_options.cpp",
        "src/apps/common/event_loop.cpp",
        "src/apps/common/ppm_writer.cpp",
    ],
    header_libs: [
        "libcamera_includes",
    ],
    shared_libs: [
        "libevent",
        "libdrm",
        "libcamera",
    ],
    static_libs: [
        "libyaml",
    ],
}
